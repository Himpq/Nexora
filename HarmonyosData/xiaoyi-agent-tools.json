{
  "schema_version": "nexora-learning-agent-tools/v1",
  "name": "nexora_learning",
  "description": "Nexora Learning 主动学习伙伴的 HTTP 工具契约草案",
  "base_url": "https://chat.himpqblog.cn:5002",
  "authentication": {
    "type": "api_key",
    "header": "X-API-Key",
    "user_header": "X-Nexora-Username"
  },
  "response_envelope": {
    "success": "boolean",
    "request_id": "string",
    "action": "string",
    "data": "object",
    "next_actions": "array",
    "error": "object|null"
  },
  "tools": [
    {
      "name": "get_learning_context",
      "description": "读取用户已选课程、教材、学习进度、最近记录和可恢复会话",
      "method": "GET",
      "path": "/api/agent/v1/context",
      "parameters": {
        "username": { "in": "query", "type": "string", "required": true },
        "lecture_id": { "in": "query", "type": "string", "required": false }
      }
    },
    {
      "name": "make_learning_plan",
      "description": "按照当前进度和用户可用时间选择下一学习目标",
      "method": "POST",
      "path": "/api/agent/v1/plan",
      "body": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": { "type": "string" },
          "intent": { "type": "string", "default": "continue_learning" },
          "available_minutes": { "type": "integer", "minimum": 5, "maximum": 240 },
          "lecture_id": { "type": "string" },
          "book_id": { "type": "string" },
          "chapter_index": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "name": "get_today_learning_brief",
      "description": "读取今日学习摘要，并决定继续未关闭会话还是开始下一学习目标",
      "method": "GET",
      "path": "/api/agent/v1/today",
      "parameters": {
        "username": { "in": "query", "type": "string", "required": true },
        "lecture_id": { "in": "query", "type": "string", "required": false }
      }
    },
    {
      "name": "open_learning_session",
      "description": "创建会话并返回打开 NexoraLearning 学习工作区的深链接",
      "method": "POST",
      "path": "/api/agent/v1/open-session",
      "body": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": { "type": "string" },
          "lecture_id": { "type": "string" },
          "book_id": { "type": "string" },
          "chapter_index": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "name": "ask_in_textbook_context",
      "description": "只依据教材章节或选中文本回答学习问题",
      "method": "POST",
      "path": "/api/agent/v1/ask-in-context",
      "body": {
        "type": "object",
        "required": ["username", "question"],
        "properties": {
          "username": { "type": "string" },
          "question": { "type": "string" },
          "lecture_id": { "type": "string" },
          "book_id": { "type": "string" },
          "chapter_index": { "type": "integer", "minimum": 0 },
          "context_text": { "type": "string" },
          "selected_text": { "type": "string" }
        }
      }
    },
    {
      "name": "create_review_plan",
      "description": "创建章节复习小测任务，返回 task_id",
      "method": "POST",
      "path": "/api/agent/v1/review-plan",
      "headers": { "Idempotency-Key": "string, recommended" },
      "body": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": { "type": "string" },
          "lecture_id": { "type": "string" },
          "book_id": { "type": "string" },
          "chapter_index": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
      }
    },
    {
      "name": "poll_review_task",
      "description": "查询复习小测任务状态",
      "method": "GET",
      "path": "/api/agent/v1/tasks/{task_id}",
      "parameters": {
        "task_id": { "in": "path", "type": "string", "required": true },
        "username": { "in": "header", "name": "X-Nexora-Username", "type": "string", "required": true }
      }
    },
    {
      "name": "record_learning_event",
      "description": "记录会话开始、完成等学习事件，支持 event_id 幂等",
      "method": "POST",
      "path": "/api/agent/v1/events",
      "body": {
        "type": "object",
        "required": ["username", "event"],
        "properties": {
          "username": { "type": "string" },
          "event": { "type": "string" },
          "event_id": { "type": "string" },
          "session_id": { "type": "string" },
          "lecture_id": { "type": "string" },
          "book_id": { "type": "string" },
          "chapter_index": { "type": "integer" },
          "source": { "type": "string", "default": "xiaoyi" }
        }
      }
    }
  ]
}
